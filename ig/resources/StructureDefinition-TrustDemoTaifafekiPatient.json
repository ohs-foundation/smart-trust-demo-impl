      {
        "id": "Patient.identifier",
        "path": "Patient.identifier",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "system"
            }
          ],
          "rules": "open"
        },
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "Patient.identifier:hn",
        "path": "Patient.identifier",
        "sliceName": "hn",
        "min": 1,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Patient.identifier:hn.system",
        "path": "Patient.identifier.system",
        "min": 1,
        "patternUri": "http://smart.who.int/trust-demo/sid/xxr-kesaro-hn"
      },
      {
        "id": "Patient.identifier:hn.value",
