{
  "resourceType": "StructureDefinition",
  "id": "TrustDemoOnesaPatient",
  "url": "http://smart.who.int/trust-demo/StructureDefinition/TrustDemoOnesaPatient",
  "name": "TrustDemoOnesaPatient",
  "title": "Onesa: child registered by the community health worker",
  "status": "draft",
  "description": "How it is used: J2 onwards. Vilay registers Somsak on a home visit, and the same patient carries every Onesan record that follows: the verified Taifafeki doses, the Onesan doses and the summary shared in J4.\n\nWhy: a child born abroad is not in the Onesan civil registry yet. A temporary id lets the CHW, the district clinic and the national portal all refer to the same child until civil registration catches up. The parents are recorded as contacts, because they hold the paper cards and later the family's VHLs.",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Patient",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Patient",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Patient.identifier",
        "path": "Patient.identifier",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "system"
            }
          ],
          "rules": "open"
        },
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "Patient.identifier:temporaryId",
        "path": "Patient.identifier",
        "sliceName": "temporaryId",
        "min": 0,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Patient.identifier:temporaryId.system",
        "path": "Patient.identifier.system",
        "min": 1,
        "patternUri": "http://smart.who.int/trust-demo/sid/onesa-temporary-id"
      },
      {
        "id": "Patient.identifier:temporaryId.value",
        "path": "Patient.identifier.value",
        "min": 1
      },
      {
        "id": "Patient.name",
        "path": "Patient.name",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "Patient.birthDate",
        "path": "Patient.birthDate",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "Patient.contact",
        "path": "Patient.contact",
        "mustSupport": true
      }
    ]
  }
}
