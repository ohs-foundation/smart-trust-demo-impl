          {
            "code": "TD.J3B.DE01",
            "system": "http://smart.who.int/trust-demo/CodeSystem/TrustDemoDataElements",
            "display": "Issuer's product code"
          }
        ],
        "short": "Issuer's product code",
        "definition": "The vaccine code as the issuer signed it; kept, never replaced (STD-SEM-001).",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Coding"
          }
        ],
        "binding": {
