+  /**
+   * Creates the one BALP Query AuditEvent of a search or page fetch. The patient is named only when
+   * every returned resource in the Patient compartment belongs to the same one; BALP's
+   * one-event-per-patient split is not applied, so a search stays a single event.
+   */
+  private AuditEvent createAuditEventQuery(
+      RestOperationTypeEnum restOperationType, AuditEventBuilder.ResourceContext resourceContext) {
+    IBaseResource response = resourceContext.getResourceEntity();
+    Set<String> patientIds = new TreeSet<>();
+    if (response instanceof Bundle) {
+      for (Bundle.BundleEntryComponent entry : ((Bundle) response).getEntry()) {
+        if (entry.getResource() instanceof DomainResource) {
+          patientIds.addAll(patientFinder.findPatientIds((DomainResource) entry.getResource()));
+        }
+      }
+    }
+    BalpProfileEnum balpProfile =
+        patientIds.size() == 1 ? BalpProfileEnum.PATIENT_QUERY : BalpProfileEnum.BASIC_QUERY;
+
+    // A page carries no resource type; HAPI's BalpAuditCaptureInterceptor records it the same way.
+    AuditEventBuilder auditEventBuilder =
+        initBaseAuditEventBuilder(
+            restOperationType == RestOperationTypeEnum.GET_PAGE
+                ? RestOperationTypeEnum.SEARCH_TYPE
+                : restOperationType,
+            balpProfile);
+    if (balpProfile == BalpProfileEnum.PATIENT_QUERY) {
+      auditEventBuilder.addEntityWhat(balpProfile, true, patientIds.iterator().next());
+    }
+    auditEventBuilder.addQuery(resourceContext.getQueryEntity());
+    if (response instanceof OperationOutcome) {
+      auditEventBuilder.outcome(createOutcome((OperationOutcome) response));
+    }
     return auditEventBuilder.build();
   }
 
