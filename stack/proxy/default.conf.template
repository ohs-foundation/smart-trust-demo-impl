proxy_set_header Host $http_host;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $http_host;
proxy_set_header X-Forwarded-Port ${PROXY_PORT};
proxy_buffer_size 16k;
proxy_buffers 8 16k;
client_max_body_size 50m;
resolver 127.0.0.11 valid=10s;

server {
  listen 80 default_server;
  return 404;
}

server {
  listen 80;
  server_name keycloak.onesa.${STACK_HOST};
  # The admin console and master realm stay off the LAN; administer with kcadm.sh inside the container.
  location ~ ^/(admin|realms/master)(/|$) { return 403; }
  location / { set $u http://keycloak:8080; proxy_pass $u; }
}

server {
  listen 80;
  server_name gateway.onesa.${STACK_HOST};
  location / { set $u http://gateway:8080; proxy_pass $u; }
}

server {
  listen 80;
  server_name medplum.kesaro.${STACK_HOST};
  # Medplum 5.2.13 runs out of memory on any GraphQL call; nothing in the demo uses it.
  location ~* ^/fhir/R4/\$graphql$ { return 403; }
  location / { set $u http://medplum:8103; proxy_pass $u; }
}

server {
  listen 80;
  server_name client.kesaro.${STACK_HOST};
  return 301 https://$host:${VHL_TLS_PORT}$request_uri;
}

server {
  listen 443 ssl;
  server_name client.kesaro.${STACK_HOST};
  ssl_certificate /etc/nginx/tls/kesaro.crt;
  ssl_certificate_key /etc/nginx/tls/kesaro.key;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Host $http_host;
  proxy_set_header X-Forwarded-Port ${VHL_TLS_PORT};
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://medplum.kesaro.${STACK_HOST}:${VHL_TLS_PORT}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header X-Content-Type-Options "nosniff" always;
  location / { set $u http://client:3000; proxy_pass $u; }
}

server {
  listen 443 ssl;
  server_name medplum.kesaro.${STACK_HOST};
  ssl_certificate /etc/nginx/tls/kesaro.crt;
  ssl_certificate_key /etc/nginx/tls/kesaro.key;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Host $http_host;
  proxy_set_header X-Forwarded-Port ${VHL_TLS_PORT};
  location ~* ^/fhir/R4/\$graphql$ { return 403; }
  location / { set $u http://medplum:8103; proxy_pass $u; }
}

server {
  listen 80;
  server_name trust.gdhcn.${STACK_HOST};
  location / { set $u http://gdhcn:80; proxy_pass $u; }
}

server {
  listen 443 ssl;
  server_name vhl.onesa.${STACK_HOST};
  ssl_certificate /etc/nginx/tls/vhl.crt;
  ssl_certificate_key /etc/nginx/tls/vhl.key;
  proxy_set_header X-Forwarded-Port ${VHL_TLS_PORT};
  location / { set $u http://vhl:8080; proxy_pass $u; }
}
