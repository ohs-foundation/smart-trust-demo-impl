# Copied to .env by init-env.sh, which fills STACK_HOST from the LAN address and every
# empty secret with a random value. Phones on the same network reach the stack by these names.
STACK_HOST=
BIND_ADDR=0.0.0.0
PROXY_PORT=8480
HAPI_HOST_PORT=18082
PLUGIN_SRC=https://github.com/ohs-foundation/ohs-player-reference-backend.git#9190c7fbd8a18de9c9134e74fabe0a34b789d413

ONESA_POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
HAPI_FHIR_DB_PASSWORD=
FHIR_GATEWAY_KEYCLOAK_CLIENT_SECRET=
TRUSTDEMO_CLI_CLIENT_SECRET=
TRUSTDEMO_USER_PASSWORD=

MEDPLUM_DB_PASSWORD=
MEDPLUM_REDIS_PASSWORD=
MEDPLUM_SUPER_ADMIN_PASSWORD=
MEDPLUM_SUPER_ADMIN_CLIENT_ID=
MEDPLUM_SUPER_ADMIN_CLIENT_SECRET=
