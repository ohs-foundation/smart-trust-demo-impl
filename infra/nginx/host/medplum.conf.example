# Host nginx vhost for Medplum.
#
# Generated by `./dev.sh render` from this template.
#
# ${MEDPLUM_HOST} must resolve publicly to this server's external IP.

server {
    listen 80;
    listen [::]:80;
    server_name ${MEDPLUM_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${MEDPLUM_HOST};

    ssl_certificate     /etc/letsencrypt/live/${MEDPLUM_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MEDPLUM_HOST}/privkey.pem;

    client_max_body_size 50m;

    # Medplum 5.2.13 runs out of memory on any GraphQL call; nothing in the demo uses it.
    location ~* \$graphql {
        return 403;
    }

    location / {
        proxy_pass http://127.0.0.1:${MEDPLUM_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  443;
    }
}
