# Host nginx vhost for the VHL service.
#
# Generated by `./dev.sh render` from this template. VHL links must be https, so port 80 answers
# only the ACME challenge and serves no route.
#
# ${VHL_HOST} must resolve publicly to this server's external IP.

server {
    listen 80;
    listen [::]:80;
    server_name ${VHL_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 404;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${VHL_HOST};

    ssl_certificate     /etc/letsencrypt/live/${VHL_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${VHL_HOST}/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:${VHL_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  443;
    }
}
