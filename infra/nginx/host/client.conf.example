# Host nginx vhost for the Taifafeki facility client.
#
# Generated by `./dev.sh render` from this template. Camera scanning needs https.
#
# ${CLIENT_HOST} must resolve publicly to this server's external IP.

server {
    listen 80;
    listen [::]:80;
    server_name ${CLIENT_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${CLIENT_HOST};

    ssl_certificate     /etc/letsencrypt/live/${CLIENT_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CLIENT_HOST}/privkey.pem;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://${MEDPLUM_HOST}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;

    location / {
        proxy_pass http://127.0.0.1:${CLIENT_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  443;
    }
}
