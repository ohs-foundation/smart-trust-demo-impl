# Host nginx vhost for the stand-in GDHCN trust-list host (TEST ONLY lists and DIDs).
#
# Generated by `./dev.sh render` from this template.
#
# ${TRUST_HOST} must resolve publicly to this server's external IP.

server {
    listen 80;
    listen [::]:80;
    server_name ${TRUST_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${TRUST_HOST};

    ssl_certificate     /etc/letsencrypt/live/${TRUST_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${TRUST_HOST}/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:${TRUST_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
