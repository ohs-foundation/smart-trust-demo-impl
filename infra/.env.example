# `./dev.sh init` copies this to .env and replaces every [generated] marker with a random secret.
# .env is gitignored and must never be committed.

# --- Public hostnames --------------------------------------------------------
# Each must resolve publicly to the server's external IP; `./dev.sh nginx` takes a certificate per name.
BASE_DOMAIN=demo.example.org
KEYCLOAK_HOST=keycloak.onesa.${BASE_DOMAIN}
GATEWAY_HOST=gateway.onesa.${BASE_DOMAIN}
WEB_HOST=web.onesa.${BASE_DOMAIN}
VHL_HOST=vhl.onesa.${BASE_DOMAIN}
MEDPLUM_HOST=medplum.kesaro.${BASE_DOMAIN}
CLIENT_HOST=client.kesaro.${BASE_DOMAIN}
TRUST_HOST=trust.gdhcn.${BASE_DOMAIN}
# Analytics vhosts, only with `./dev.sh up --pipes`; set them to pipeline.onesa.${BASE_DOMAIN} and
# superset.onesa.${BASE_DOMAIN}. The pipeline controller has no login of its own.
PIPELINE_HOST=
SUPERSET_HOST=
CERTBOT_EMAIL=

# --- Secrets -----------------------------------------------------------------
POSTGRES_ADMIN_PASSWORD=[generated]
KEYCLOAK_DB_PASSWORD=[generated]
HAPI_FHIR_DB_PASSWORD=[generated]
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=[generated]
FHIR_GATEWAY_KEYCLOAK_CLIENT_SECRET=[generated]
TRUSTDEMO_CLI_CLIENT_SECRET=[generated]
TRUSTDEMO_USER_PASSWORD=[generated]
SUPERSET_SECRET_KEY=[generated]

# --- Gateway build -----------------------------------------------------------
# Checkout of the backend fork (branch trust-demo-household), relative to this directory or absolute.
GATEWAY_PLUGIN_DIR=../../ohs-player-reference-backend-fork

# Hosts HAPI may deliver Subscription notifications to: the machine running `trust-demo watch`.
SUBSCRIPTION_ALLOWED_ENDPOINTS=host.docker.internal:18090

# --- Build refs and Portal build args ----------------------------------------
WEB_REF=main
VITE_FHIR_VERSION=R4

# --- Host ports, all bound to loopback behind host nginx ---------------------
POSTGRES_HOST_PORT=5433
KEYCLOAK_PORT=8081
HAPI_FHIR_PORT=8082
FHIR_GATEWAY_PORT=8083
OHS_PLAYER_WEB_PORT=8084
POSTGRES_ANALYTICS_PORT=5434
PIPELINE_PORT=8090
SUPERSET_PORT=8088
