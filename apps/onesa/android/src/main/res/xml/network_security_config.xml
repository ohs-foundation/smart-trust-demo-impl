<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds allow no cleartext and trust the system CAs only; the debug variant replaces
     this file with a generated one for the demo stack. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
