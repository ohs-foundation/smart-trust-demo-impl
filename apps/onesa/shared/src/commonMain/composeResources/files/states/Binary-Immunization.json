{
  "resourceType": "https://sql-on-fhir.org/ig/StructureDefinition/ViewDefinition",
  "url": "http://ohs.dev/ViewDefinition/Immunization",
  "fhirVersion": [
    "4.0.1"
  ],
  "select": [
    {
      "column": [
        {
          "name": "immunizationId",
          "path": "id",
          "type": "http://hl7.org/fhir/StructureDefinition/string"
        },
        {
          "name": "vaccineName",
          "path": "iif(vaccineCode.coding.display.exists(), vaccineCode.coding.display.first(), vaccineCode.coding.code.first())",
          "type": "http://hl7.org/fhir/StructureDefinition/string"
        },
        {
          "name": "occurrenceDate",
          "path": "occurrence",
          "type": "http://hl7.org/fhir/StructureDefinition/dateTime"
        },
        {
          "name": "immunizationStatus",
          "path": "status",
          "type": "http://hl7.org/fhir/StructureDefinition/code"
        },
        {
          "name": "verified",
          "path": "primarySource",
          "type": "http://hl7.org/fhir/StructureDefinition/boolean"
        },
        {
          "name": "productCode",
          "path": "vaccineCode.coding.where(system = 'http://smart.who.int/pcmt-vaxprequal/CodeSystem/PreQualProductIds').code.first()",
          "type": "http://hl7.org/fhir/StructureDefinition/string"
        },
        {
          "name": "scheduleCode",
          "path": "vaccineCode.coding.where(system = 'http://smart.who.int/trust-demo/CodeSystem/TrustDemoOnesaEpiSchedule').code.first()",
          "type": "http://hl7.org/fhir/StructureDefinition/string"
        },
        {
          "name": "lotNumber",
          "path": "lotNumber",
          "type": "http://hl7.org/fhir/StructureDefinition/string"
        },
        {
          "name": "location",
          "path": "location.display",
          "type": "http://hl7.org/fhir/StructureDefinition/string"
        },
        {
          "name": "immunizationPatientRef",
          "path": "patient.reference.replace('Patient/', '')",
          "type": "http://hl7.org/fhir/StructureDefinition/string"
        }
      ]
    }
  ],
  "name": "Immunization",
  "status": "active",
  "resource": "Immunization"
}
