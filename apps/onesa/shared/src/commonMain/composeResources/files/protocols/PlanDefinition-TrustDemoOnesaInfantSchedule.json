  "version": "1.0.0",
  "name": "TrustDemoOnesaInfantSchedule",
  "title": "National infant immunization schedule (illustrative excerpt)",
  "status": "active",
  "description": "The IG's national infant schedule with TD.DT.04 as FHIRPath. Each action has a child that applies when the dose is complete (rule 1) and one that applies when it is due (rule 2); neither applying is rule 3, not yet. %code is the action's schedule code; %counted and %nextVisit are CodeableConcepts holding the schedule codes TD.DT.03 counts and the codes of the next visit. The supported-by extension names the schedule codes whose doses share an antigen with the action (pentavalent contains hepatitis B).",
  "type": {
    "coding": [
      {
        "code": "clinical-protocol",
        "system": "http://terminology.hl7.org/CodeSystem/plan-definition-type"
      }
    ]
  },
  "action": [
    {
      "id": "hepb-birth",
      "title": "Birth doses",
      "code": [
        {
          "coding": [
            {
              "code": "XXU-EPI-HEPB-BD",
              "system": "http://smart.who.int/trust-demo/CodeSystem/TrustDemoOnesaEpiSchedule",
              "display": "Hepatitis B birth dose"
            }
          ]
        }
      ],
      "timingAge": {
        "value": 0,
        "code": "d",
        "system": "http://unitsofmeasure.org",
        "unit": "days"
      },
      "action": [
        {
          "id": "counted",
          "title": "Complete",
          "condition": [
            {
              "kind": "applicability",
              "expression": {
                "language": "text/fhirpath",
                "expression": "%counted.coding.code contains %code"
              }
            }
          ]
        },
        {
          "id": "due",
          "title": "Due",
          "condition": [
            {
              "kind": "applicability",
              "expression": {
                "language": "text/fhirpath",
                "expression": "(%counted.coding.code contains %code).not() and (%nextVisit.coding.code contains %code)"
              }
            }
